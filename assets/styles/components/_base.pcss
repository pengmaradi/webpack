[v-cloak],
[x-cloak] {
    display: none;
}

@keyframes fadeInUp {
    0% {
        opacity: 0;
        transform: translateY(30%);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

.fadeInUp {
    animation: fadeInUp 1s;
}

@keyframes scale {
    0% {
        opacity: 0;
        transform: scale(0.7);
    }
    100% {
        opacity: 1;
        transform: scale(1);
    }
}

@layer base {
    body {
        @apply font-roboto min-h-screen p-0 bg-gray-400 dark:bg-gray-500 dark:text-neutral-900;

        footer {
            @apply font-roboto;
        }
    }
}

a {
    @apply text-blue-500;
}



.scale {
    animation: scale 1s;
}

.text-custom {
  @apply text-test dark:bg-secondary-300;
}

.main-nav {
    @apply bg-gray-500 dark:bg-gray-800;

    a {
        @apply text-sky-300 dark:text-sky-500;
    }
}

@layer base {
    .x-slash {
        @apply relative flex;

        &::before {
            @apply top-2 sm:top-2.5 lg:top-3 translate-y-[-50%] content-[''] absolute inline-block bg-secondary h-6 -left-5 w-[5px] ;
        }
    }

    .x-clip-left {
        @screen sm {
            clip-path: polygon(116px 24px, 0 100%, 100% 100%, 100% 24px);
        }

        @screen lg {
            clip-path: polygon(224px 48px, 0 100%, 100% 100%, 100% 48px);
        }
    }

    .clip-left {
        clip-path: polygon(0 0, 55% 0, 45% 100%, 0 100%);
    }

    .clip-right {
        clip-path: polygon(55% 0, 100% 0, 100% 100%, 45% 100%);

        img {
            @apply w-full h-full object-cover object-center mt-8;
        }
    }
}

