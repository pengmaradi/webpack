<div class="splide" x-data="imageSlider" role="group">
    <div class="splide__track">
        <ul class="splide__list">
            {% for i in 70..90 %}
            <li class="splide__slide">
                <img src="https://mdbcdn.b-cdn.net/img/new/slides/0{{i}}.webp"
                    class="w-full" alt="image{{i}}">
            </li>
            {% endfor %}
        </ul>
    </div>
</div>