<nav class="relative flex p-3 justify-between bg-neutral-secondary-medium" aria-label="main-navigation" x-data="{show: false}">
    <a href="/" class="flex items-center">
        <img src="https://flowbite.com/docs/images/logo.svg" class="h-7 me-3" alt="Logo" />
        <span class="text-heading self-center text-2xl font-semibold whitespace-nowrap">Flow</span>
    </a>

    <ul class="hidden md:flex flex-wrap items-center justify-between gap-4">
        <li><a href="/">home</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/product">product</a></li>
        <li><a href="/news">news</a></li>
    </ul>

    {% include "components/searchbox" %}
    {% include "components/darkMode" %}

    <div class="flex md:hidden absolute right-12 items-center gap-3">

        <!-- Hamburger Button (mobile only) -->
        <button id="hamburger-btn" class="flex flex-col gap-1 p-2"
            @click="show=!show"
            aria-label="Toggle menu"
            :aria-expanded="show.toString()">
            <span class="block w-6 h-0.5 bg-sky-500 transition-transform duration-300" :class="show && 'rotate-45 translate-y-2'"></span>
            <span class="block w-6 h-0.5 bg-sky-500 transition-opacity duration-300" :class="show && 'opacity-0'"></span>
            <span class="block w-6 h-0.5 bg-sky-500 transition-transform duration-300" :class="show && '-rotate-45 -translate-y-1'"></span>
        </button>
    </div>
    <!-- Backdrop/Overlay -->
    <div x-show="show" x-transition:enter="transition-opacity ease-out duration-300" x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100" x-transition:leave="transition-opacity ease-in duration-200"
        x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" @click="show = false"
        class="fixed -z-10 inset-0 bg-black/50 md:hidden" aria-hidden="true">
    </div>
    <!-- Mobile Menu (hidden by default) -->
    <div id="mobile-menu"
        x-transition:enter="transition-opacity ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition-opacity ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @click.away="show = false"
        @keydown.escape.window="show = false"
        x-show="show" 
        class="absolute z-10 left-0 top-full right-0 flex justify-center bg-neutral-secondary-medium px-3 pb-3 shadow-lg">
    <ul class="flex flex-col gap-3">
        <li><a href="/" class="block py-2">home</a></li>
        <li><a href="/about" class="block py-2">about</a></li>
        <li><a href="/product" class="block py-2">product</a></li>
        <li><a href="/news" class="block py-2">news</a></li>
    </ul>
    
</div>


</nav>

<!-- Breadcrumb -->
<nav class="flex p-3" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
        <li class="inline-flex items-center">
            <a href="/" class="inline-flex items-center text-sm font-medium text-body hover:text-fg-brand">
                <svg class="w-4 h-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                    fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="m4 12 8-8 8 8M6 10.5V19a1 1 0 0 0 1 1h3v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h3a1 1 0 0 0 1-1v-8.5" />
                </svg>
            </a>
        </li>
        {% if page != 'home' %}
        <li>
            <div class="flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5 rtl:rotate-180 text-body" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                    width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="m9 5 7 7-7 7" />
                </svg>
                
                <a href="/{{ page }}"
                    class="inline-flex items-center text-sm font-medium text-body hover:text-fg-brand">{{ page }}</a>
                
                
            </div>
        </li>
        {% endif %}
    </ol>
</nav>
